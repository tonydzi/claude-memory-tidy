<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sample launchd agent for memory_tidy.sh. Copy to ~/Library/LaunchAgents/, replace
  $HOME with your absolute home path (launchd does not expand variables in paths), then:
      launchctl load ~/Library/LaunchAgents/com.example.memory-tidy.plist

  WHY TWO TIMES: launchd has no anacron catch-up — a calendar job whose moment passed while
  the Mac was asleep is skipped silently. The second slot is the catch-up, and it is free:
  on a day the first slot ran, the detectors return "nothing to do" and no model is called.

  Times below are the MACHINE's local time. Pick hours that fall in the quiet part of YOUR
  day; if your machine's timezone differs from where you live, convert deliberately and
  write the conversion in this comment so the next reader does not have to guess.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.memory-tidy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>$HOME/.claude/scripts/memory_tidy.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>40</integer></dict>
  </array>

  <!-- launchd hands an almost-empty PATH; the script re-exports its own, this is belt+braces. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>MACHINE_KEY</key><string>my-laptop</string>
    <key>PYTHONUTF8</key><string>1</string>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>$HOME/.claude/scripts/_memory_tidy.out.log</string>
  <key>StandardErrorPath</key><string>$HOME/.claude/scripts/_memory_tidy.err.log</string>
</dict>
</plist>
